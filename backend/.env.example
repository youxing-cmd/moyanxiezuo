# ============================================
# 九章写作 后端环境变量
# 复制本文件为 .env 后填入真实值（.env 不应提交到 git）
# ============================================

# ---------- 内置预设模型（必填） ----------
# 所有内置模型共用同一个 OpenAI 兼容网关 + 同一个 key
# 配置好之后，前端会根据 backend/src/config/presetModels.ts 列出可选模型
WANGSU_BASE_URL=
WANGSU_API_KEY=

# ---------- AI 调用稳定性（可选） ----------
# 同时进行的 AI 请求上限（保护服务不被慢请求堆死）
AI_MAX_CONCURRENT=10
# 排队等待槽位的最长时间（毫秒）
AI_QUEUE_TIMEOUT_MS=15000
# 流式上游响应超时（毫秒，足够生成长文）
AI_STREAM_TIMEOUT_MS=120000
# 非流式上游响应超时（毫秒）
AI_TIMEOUT_MS=45000

# ---------- 兜底回退（可选，留空时不启用） ----------
# 当用户没有指定模型且预设模型都未配置时使用的最后回退
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ---------- 安全（必填） ----------
# JWT 签名密钥，用于用户登录态。生成方法：openssl rand -hex 32
# !!! 生产环境务必设置为强随机字符串，不要使用代码中的默认 fallback !!!
JWT_SECRET=

# ---------- 服务端口（可选） ----------
PORT=3000

# ---------- 热搜数据源（可选） ----------
# 留空时后端会内嵌启动 DailyHotApi（端口 6688）
DAILY_HOT_API_URL=

# ---------- 风向标 / 灵感生成模型（可选） ----------
# 留空时复用 AI_MODEL
TREND_WINDVANE_MODEL=
TREND_INSPIRATION_MODEL=

# ---------- 是否启用动态热搜抓取（可选） ----------
# true: 启用 Playwright 抓真实热搜；false: 使用硬编码数据
ENABLE_DYNAMIC_TRENDS=false

# ---------- 数据库 ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jiuzhang

# ---------- 飞书登录（可选） ----------
# 飞书开放平台自建应用：https://open.feishu.cn/app
# 申请后把 App ID / App Secret 填入，并在安全设置中配置重定向 URL
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback
